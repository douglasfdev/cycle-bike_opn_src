  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CycleBike": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Wolverine": "Error",
      "System": "Error"
    }
  },
  "Authentication": {
    "Authority": "http://localhost:8081/realms/CycleBike",
    "Audience": "account"
  },
  "SocketIOAdapterOptions": {
    "ServerUrl": "http://localhost:5161",
    "Reconnection": false,
    "ReconnectionAttempts": 5,
    "ReconnectionDelay": 1000,
    "ConnectionTimeout": 20000
  },
  "SignalROptions": {
    "HubUrl": "http://localhost:5161/realtime",
    "AutomaticReconnect": true,
    "ReconnectDelays": [0, 2000, 10000, 30000],
    "HandshakeTimeout": 15000,
    "KeepAliveInterval": 15000,
    "ServerTimeout": 30000,
    "Headers": {
      "Authorization": "Bearer {0}"
    }
  },
  "MongoDbOptions":  {
    "ConnectionString": "mongodb://username:password@localhost:27017",
    "Database": "CycleBike"
  },
  "RedisOptions": {
    "ConnectionString": "localhost:6380,user=cycle-bike,password=cyclepass123"
  },
  "OpenTelemetryOptions": {
    "Host": "http://localhost:4317"
  },
  "MessageBroker": {
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "Exchanges": [
      {
        "Process": "Payment",
        "Name": "payment.exchange",
        "Type": "topic",
        "Durable": true,
        "Queues": [
          {
            "Name": "payment.queue",
            "RoutingKey": "InitialPayment"
          }
        ]
      },
      {
        "Process": "ProductRegistration",
        "Name": "product-registration",
        "Type": "topic",
        "Durable": true,
        "Queues": [
          {
            "Name": "product-registration.step1.queue",
            "RoutingKey": "Initial"
          }
        ]
      }
    ]
    
  },
